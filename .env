# service-inventory/.env
ENVIRONMENT=development
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/industrial_stock
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30

# Cache
REDIS_URL=redis://localhost:6379
CACHE_TTL=30  # segundos

# Gateway
GATEWAY_URL=http://localhost:3000

# AWS
AWS_REGION=us-east-1

# Performance
QUERY_TIMEOUT=5
MAX_CONCURRENT_QUERIES=100

# Security
JWT_SECRET=inventory-service-secret-2024